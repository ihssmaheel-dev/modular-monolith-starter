{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @repo/email build",
    "dev": "concurrently \"swc src -w -d dist/apps/api\" \"nodemon dist/apps/api/src/main.js\"",
    "dev:debug": "concurrently \"swc src -w -d dist/apps/api\" \"nodemon --inspect=0.0.0.0:9229 dist/apps/api/src/main.js\"",
    "prebuild": "pnpm --filter @repo/email build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/apps/api/src/main.js",
    "start:prod": "node dist/apps/api/src/main.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "pretest": "pnpm --filter @repo/email build",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:coverage": "vitest run --config vitest.config.mts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:migrate:prod": "node dist/apps/api/src/infrastructure/database/migrate.js",
    "db:migrate:check": "tsx src/infrastructure/database/migration-check.ts",
    "db:migrate:raw": "drizzle-kit migrate",
    "db:migrate:status": "drizzle-kit check",
    "db:migrate:dev": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seeds/seed.ts",
    "db:backup": "bash ../../scripts/db-backup.sh",
    "db:restore": "bash ../../scripts/db-restore.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/etag": "^6.2.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.4",
    "@fastify/under-pressure": "^9.2.0",
    "@getworkbench/fastify": "^0.9.1",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.3",
    "@nestjs/platform-ws": "^12.0.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/websockets": "^12.0.3",
    "@node-rs/argon2": "^2.2.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@orpc/contract": "^1.15.2",
    "@orpc/nest": "^1.15.2",
    "@orpc/openapi": "^1.15.2",
    "@orpc/server": "^1.15.2",
    "@repo/authorization": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@scalar/fastify-api-reference": "^1.69.2",
    "@willsoto/nestjs-prometheus": "^6.1.1",
    "bullmq": "^6.3.8",
    "colorette": "^2.0.20",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "expo-server-sdk": "^7.2.0",
    "fastify": "5.12.4",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nestjs-cls": "^6.3.1",
    "neverthrow": "^8.2.0",
    "nodemailer": "^10.0.10",
    "opossum": "^10.0.0",
    "pg": "8.23.0",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "piscina": "^5.3.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.28.1",
    "rxjs": "^7.8.2",
    "undici": "^7.29.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^8.0.2",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "5.0.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "nodemon": "^3.1.14",
    "testcontainers": "^12.1.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}

# ==========================================
# ENTERPRISE MONOREPO ENVIRONMENT VARIABLES
# ==========================================

# Core Application
NODE_ENV=development
APP_NAME=Workspace
APP_SLUG=modular-monolith
EXAMPLE_FEATURES_ENABLED=true
# Optional Python intelligence service. Keep disabled unless this application needs it.
INTELLIGENCE_ENABLED=false
INTELLIGENCE_SERVICE_URL=http://intelligence:8080
INTELLIGENCE_SERVICE_AUDIENCE=modular-monolith-intelligence
# INTELLIGENCE_SERVICE_TOKEN_FILE=/run/secrets/intelligence_service_token
# INTELLIGENCE_DATA_ENCRYPTION_KEY=replace-with-a-random-32-character-key
INTELLIGENCE_PROVIDER=openai-compatible
INTELLIGENCE_MODEL=
INTELLIGENCE_EMBEDDING_MODEL=
INTELLIGENCE_MAX_OUTPUT_TOKENS=2048
INTELLIGENCE_MAX_CONTEXT_ITEMS=20
INTELLIGENCE_MAX_DOCUMENT_BYTES=10485760
PORT=5156
LOG_LEVEL=info

# Tenancy (single | multi). Choose once before adding production data.
TENANCY_MODE=single

# URLs & CORS
CLIENT_URL=http://localhost:5155
API_URL=http://localhost:5156

# Database & Cache
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app
# Integration/E2E tests only; the database name must contain "test"
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/architecture_test
DB_MAX_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
REDIS_URL=redis://127.0.0.1:6379
# JSON object of static feature flags, overridden at runtime by Redis when configured
FEATURE_FLAGS={}

# Auth & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-prod
JWT_REFRESH_SECRET=your-separate-refresh-secret-change-in-prod
JWT_ISSUER=modular-monolith-api
JWT_AUDIENCE=modular-monolith-client
# Optional JSON keyrings for overlapping JWT signing-key rotation.
# JWT_SIGNING_KEYS={"primary":"replace-with-access-secret-key-32chars","next":"replace-with-next-access-secret-key-32chars"}
# JWT_ACTIVE_KEY_ID=primary
# JWT_REFRESH_SIGNING_KEYS={"primary":"replace-with-refresh-secret-key-32chars","next":"replace-with-next-refresh-secret-key-32chars"}
# JWT_REFRESH_ACTIVE_KEY_ID=primary
METRICS_TOKEN=optional-development-metrics-token-32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TTL=60
WORKER_METRICS_PORT=9464
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_PROCESSING_TTL_SECONDS=300
IDEMPOTENCY_STALE_AFTER_SECONDS=60
IDEMPOTENCY_MAX_RESPONSE_BYTES=1048576

# Account Lockout
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Observability & OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
LOKI_HOST=http://localhost:3100
# Optional provider-neutral JSON error sink (leave empty to rely on structured logs)
# ERROR_REPORTING_URL=https://telemetry.example.com/v1/errors
# ERROR_REPORTING_TOKEN_FILE=/run/secrets/error_reporting_token

# Storage (s3)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
FILE_USER_QUOTA_BYTES=104857600
FILE_TENANT_QUOTA_BYTES=10737418240
FILE_TENANT_MAX_OBJECTS=100000
FILE_AV_ENABLED=false

# Email (resend | smtp)
EMAIL_DRIVER=smtp
EMAIL_FROM=noreply@example.com

# Resend (only when EMAIL_DRIVER=resend)
RESEND_API_KEY=

# SMTP (only when EMAIL_DRIVER=smtp)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Optional one-time administrative seed (set both or neither)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace-with-a-long-random-password

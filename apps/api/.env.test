# Test Environment Variables
NODE_ENV=test
PORT=3000
LOG_LEVEL=warn

# URLs & CORS
CLIENT_URL=http://localhost:5155
API_URL=http://localhost:5156

# Database & Cache
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_test
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_test
DB_MAX_POOL_SIZE=5
REDIS_URL=redis://localhost:6379

# Auth & Security
JWT_SECRET=test-secret-with-at-least-32-chars-long
JWT_REFRESH_SECRET=test-refresh-secret-with-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TTL=60

# Storage (s3)
STORAGE_DRIVER=s3

# Email (resend | smtp)
EMAIL_DRIVER=smtp
EMAIL_FROM=noreply@example.com

# SMTP (only when EMAIL_DRIVER=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025


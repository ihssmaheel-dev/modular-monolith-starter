{
  "name": "@repo/email",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "dev": "concurrently \"email dev --dir ./src/emails -p 3002\" \"tsc --watch --preserveWatchOutput\"",
    "clean": "rm -rf dist .react-email"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.9.5"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.5",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "19.2.18",
    "concurrently": "^9.1.2",
    "typescript": "~6.0.3"
  }
}

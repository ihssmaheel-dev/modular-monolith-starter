# Staging environment. Committed with deliberately WEAK values for local verification.
# NEVER use these values in production. For custom secrets, copy this file to
# docker/.env.staging (gitignored) and pass --env-file explicitly.
TENANCY_MODE=single

# Browser-facing origins (staging nginx on :8080).
CLIENT_URL=http://localhost:8080
API_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080/api/v1
VITE_APP_NAME=Workspace

# In-compose dependencies (service hostnames, NOT localhost).
DATABASE_URL=postgres://postgres:postgres@postgres:5432/app
REDIS_URL=redis://redis:6379

# Fake staging-only secrets. 32+ characters to satisfy validation.
JWT_SECRET=staging-access-secret-32-characters
JWT_REFRESH_SECRET=staging-refresh-secret-32-chars
METRICS_TOKEN=staging-metrics-token-32-characters

# Email goes to staging Mailpit (host :8026), never to the real world.
EMAIL_DRIVER=smtp
EMAIL_FROM=staging@example.test
SMTP_HOST=mailpit
SMTP_PORT=1025

# Object storage is staging MinIO (host :9002, console :9003).
S3_ENDPOINT=http://minio:9000
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

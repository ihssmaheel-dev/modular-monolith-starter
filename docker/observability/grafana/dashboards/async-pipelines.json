      "title": "Realtime Connections and Consumer Lag",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(realtime_active_connections) by (type)",
          "legendFormat": "Connections {{type}}",
          "refId": "A"
        },
        {
          "expr": "realtime_consumer_lag_ms / 1000",
          "legendFormat": "Consumer lag (s)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "id": 6,
      "title": "Dead Letters and Circuit Breakers",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(outbox_dead_letter_total[10m])",
          "legendFormat": "Outbox dead letters",
          "refId": "A"
        },
        {
          "expr": "increase(realtime_dead_letter_total[10m])",
          "legendFormat": "Realtime dead letters",
          "refId": "B"
        },
        {
          "expr": "circuit_breaker_state{name=\"email\"}",
          "legendFormat": "Email circuit state",
          "refId": "C"
        }
      ]
    }

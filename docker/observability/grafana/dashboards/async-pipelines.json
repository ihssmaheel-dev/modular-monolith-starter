      "targets": [
        {
          "expr": "outbox_pending_events_depth",
          "legendFormat": "Outbox pending",
          "refId": "A"
        },
        {
          "expr": "notification_delivery_pending_depth",
          "legendFormat": "Notifications pending",
          "refId": "B"
        },
        {
          "expr": "privacy_export_pending_depth",
          "legendFormat": "Privacy exports pending",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 9 },
      "id": 4,
      "title": "Async Oldest Item Age",
      "type": "timeseries",
      "targets": [
        {
          "expr": "outbox_pending_age_ms / 1000",
          "legendFormat": "Outbox",
          "refId": "A"
        },
        {
          "expr": "notification_delivery_oldest_pending_age_seconds",
          "legendFormat": "Notifications",
          "refId": "B"
        },
        {
          "expr": "privacy_export_oldest_pending_age_seconds",
          "legendFormat": "Privacy exports",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "Realtime and Provider Failure Signals",

      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "descending" }
      },
      "title": "Storage Errors by Code",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (error_code) (rate(storage_errors_total{provider=~\"$provider\",operation=~\"$operation\"}[1m]))",
          "legendFormat": "{{error_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },

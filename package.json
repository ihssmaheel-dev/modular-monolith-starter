{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "bootstrap": "node scripts/bootstrap.js",
    "doctor": "node scripts/doctor.js",
    "project:init": "node scripts/initialize-project.js",
    "prune:examples": "node scripts/prune-examples.js",
    "disable:examples": "node scripts/prune-examples.js --disable --yes",
    "dev": "turbo dev",
    "dev:api": "turbo build --filter=\"api...\" --filter=\"!api\" && pnpm --filter api dev",
    "dev:api:debug": "turbo build --filter=\"api...\" --filter=\"!api\" && pnpm --filter api dev:debug",
    "dev:web": "node scripts/ensure-web-env.js && turbo build --filter=\"web...\" --filter=\"!web\" && pnpm --filter web dev",
    "dev:mobile": "node scripts/ensure-mobile-env.js && turbo build --filter=\"mobile...\" --filter=\"!mobile\" && pnpm --filter mobile dev",
    "dev:email": "pnpm --filter @repo/email dev",
    "dev:packages": "turbo dev --filter=\"./packages/*\"",
    "storybook": "pnpm --filter @repo/ui storybook",
    "build": "turbo build",
    "build:api": "pnpm --filter api build",
    "build-storybook": "pnpm --filter @repo/ui build-storybook",
    "bundle:check": "node scripts/check-web-bundle-budgets.js",
    "lint": "turbo lint",
    "format": "prettier --cache --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --cache --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit --concurrency=2",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "test:api:watch": "pnpm --filter api test:watch",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:migrate:check": "pnpm --filter api db:migrate:check",
    "db:migrate:lineage": "node scripts/verify-migration-lineage.js",
    "db:migrate:freeze": "node scripts/verify-migration-lineage.js --update",
    "db:migrate:status": "pnpm --filter api db:migrate:status",
    "db:migrate:dev": "pnpm --filter api db:migrate:dev",
    "db:studio": "pnpm --filter api db:studio",
    "db:seed": "pnpm --filter api db:seed",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:restore:verify": "bash scripts/db-restore-verify.sh",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d --wait postgres redis minio mailpit pgadmin",
    "docker:init": "docker compose -f docker/docker-compose.yml run --rm minio-init",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:prod": "docker compose -f docker/docker-compose.prod.yml up -d --wait",
    "staging:up": "docker compose -f docker/docker-compose.staging.yml --env-file docker/.env.staging.example up -d --wait",
    "staging:logs": "docker compose -f docker/docker-compose.staging.yml logs -f",
    "staging:down": "docker compose -f docker/docker-compose.staging.yml down",
    "staging:seed": "node scripts/staging-seed.js",
    "observability:up": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.observability.yml up -d",
    "observability:down": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.observability.yml down",
    "observability:logs": "docker compose -f docker/docker-compose.observability.yml logs -f",
    "observability:check": "node scripts/validate-observability-config.js",
    "clean": "node scripts/clean.js",
    "clean:all": "node scripts/clean.js --all",
    "prepare": "husky",
    "generate:module": "node scripts/generate-module.js",
    "generate:feature": "node scripts/generate-feature.js",
    "test:generator": "node scripts/generators/generator-smoke.js && node --test scripts/project-init/*.test.js",
    "theme:generate": "pnpm --filter @repo/design-tokens generate",
    "theme:check": "pnpm --filter @repo/design-tokens check",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs apps/api/src --output-type err",
    "rules:check-style": "node scripts/check-rules.js",
    "rules:check": "pnpm architecture:check && pnpm theme:check && node scripts/check-rules.js",
    "info": "node scripts/system-info.js",
    "status": "node scripts/system-info.js",
    "up": "taze -r"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "dependency-cruiser": "17.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "taze": "^21.1.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.2",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "lint-staged": {
    "apps/api/src/**/*.ts": [
      "pnpm --filter api lint"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
